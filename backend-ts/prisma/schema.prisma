// Prisma schema — PostgreSQL + Neon
// Documentation: https://pris.ly/d/prisma-schema

generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["omitApi"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id                     String    @id @default(uuid())
  name                   String
  email                  String    @unique
  passwordHash           String
  role                   String    @default("USER")
  blocked                Boolean   @default(false)
  photo                  String?
  googleId               String?   @unique
  authProvider           String?   @default("local")
  plan                   String    @default("FREE")
  stripeCustomerId       String?
  stripeSubscriptionId   String?
  transactionsUsed       Int       @default(0)
  transactionsMonth      String    @default("")
  planExpiresAt          DateTime?
  hasCompletedOnboarding Boolean   @default(false)
  usageType              String?
  companyName            String?
  companyLogo            String?
  businessPurpose        String?
  primaryColor           String?
  phone                  String?
  isVerified             Boolean   @default(false)
  verificationCode       String?
  verificationExpires    DateTime?
  createdAt              DateTime  @default(now())
  updatedAt              DateTime  @updatedAt

  transactions        Transaction[]
  goals               Goal[]
  budgets             Budget[]
  paymentTransactions PaymentTransaction[]
  categories          Category[]
  subscription        Subscription?
  installments        Installment[]
  financialAlerts     FinancialAlert[]
  refreshTokens       RefreshToken[]
  accounts            Account[]
  creditCards         CreditCard[]
  contacts            Contact[]
  splitExpenses       SplitExpense[]

  // 2FA (TOTP)
  twoFactorSecret      String?
  twoFactorEnabled     Boolean @default(false)
  twoFactorBackupCodes String? // JSON array of bcrypt-hashed backup codes

  recurringTransactions RecurringTransaction[]
  pushSubscriptions     PushSubscription[]
  webhookSubscriptions  WebhookSubscription[]
  apiKeys               ApiKey[]
  externalConnections   ExternalConnection[]
  goalMemberships       GoalMember[]
  sentGoalInvites       GoalInvite[]           @relation("GoalInviteSender")
  receivedGoalInvites   GoalInvite[]           @relation("GoalInviteReceiver")

  @@map("users")
}

model RefreshToken {
  id               String   @id @default(uuid())
  userId           String
  tokenHash        String
  tokenFingerprint String   @unique
  expiresAt        DateTime
  createdAt        DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
  @@map("refresh_tokens")
}

model Transaction {
  id                 String    @id @default(uuid())
  userId             String
  title              String
  amount             Float
  type               String
  category           String
  description        String?
  date               DateTime
  recurring          Boolean   @default(false)
  recurringFrequency String?
  paymentMethod      String?   @default("pix")
  installments       Int       @default(1)
  installmentNumber  Int?
  totalInstallments  Int?
  totalAmount        Float?
  installmentId      String?
  accountId          String?
  cardId             String?
  currency           String    @default("BRL")
  dueDate            DateTime?
  createdAt          DateTime  @default(now())

  user          User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  installment   Installment?   @relation(fields: [installmentId], references: [id], onDelete: SetNull)
  account       Account?       @relation(fields: [accountId], references: [id], onDelete: SetNull)
  card          CreditCard?    @relation(fields: [cardId], references: [id], onDelete: SetNull)
  splitExpenses SplitExpense[]

  @@index([userId])
  @@index([userId, date])
  @@index([installmentId])
  @@index([accountId])
  @@index([cardId])
  @@map("transactions")
}

model Account {
  id        String   @id @default(uuid())
  userId    String
  name      String
  type      String   @default("corrente")
  color     String?  @default("#2563eb")
  isDefault Boolean  @default(false)
  archived  Boolean  @default(false)
  createdAt DateTime @default(now())

  user         User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  transactions Transaction[]

  @@index([userId])
  @@map("accounts")
}

model CreditCard {
  id         String   @id @default(uuid())
  userId     String
  name       String
  brand      String?
  limit      Float    @default(0)
  closingDay Int      @default(1)
  dueDay     Int      @default(10)
  color      String?  @default("#7c3aed")
  archived   Boolean  @default(false)
  createdAt  DateTime @default(now())

  user         User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  transactions Transaction[]

  @@index([userId])
  @@map("credit_cards")
}

model Contact {
  id        String   @id @default(uuid())
  userId    String
  name      String
  email     String?
  phone     String?
  color     String?  @default("#f59e0b")
  createdAt DateTime @default(now())

  user          User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  splitExpenses SplitExpense[]

  @@index([userId])
  @@map("contacts")
}

model SplitExpense {
  id            String    @id @default(uuid())
  userId        String
  transactionId String
  contactId     String
  amount        Float
  settled       Boolean   @default(false)
  settledAt     DateTime?
  createdAt     DateTime  @default(now())

  user        User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  transaction Transaction @relation(fields: [transactionId], references: [id], onDelete: Cascade)
  contact     Contact     @relation(fields: [contactId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([transactionId])
  @@index([contactId])
  @@map("split_expenses")
}

model Goal {
  id            String   @id @default(uuid())
  userId        String
  title         String
  targetAmount  Float
  currentAmount Float    @default(0)
  deadline      DateTime
  createdAt     DateTime @default(now())

  user    User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  members GoalMember[]
  invites GoalInvite[]

  @@index([userId])
  @@index([userId, deadline])
  @@map("goals")
}

// A goal has exactly one implicit owner (Goal.userId, kept for backward
// compatibility with existing rows/queries) plus zero or more members added
// via an accepted GoalInvite — both owner and members can view/contribute.
model GoalMember {
  id       String   @id @default(uuid())
  goalId   String
  userId   String
  role     String   @default("member") // owner | member
  joinedAt DateTime @default(now())

  goal Goal @relation(fields: [goalId], references: [id], onDelete: Cascade)
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([goalId, userId])
  @@index([userId])
  @@map("goal_members")
}

model GoalInvite {
  id            String    @id @default(uuid())
  goalId        String
  senderId      String
  receiverEmail String
  receiverId    String?
  status        String    @default("pending") // pending | accepted | declined
  createdAt     DateTime  @default(now())
  respondedAt   DateTime?

  goal     Goal  @relation(fields: [goalId], references: [id], onDelete: Cascade)
  sender   User  @relation("GoalInviteSender", fields: [senderId], references: [id], onDelete: Cascade)
  receiver User? @relation("GoalInviteReceiver", fields: [receiverId], references: [id], onDelete: SetNull)

  @@index([receiverEmail])
  @@index([goalId])
  @@map("goal_invites")
}

model Budget {
  id        String   @id @default(uuid())
  userId    String
  category  String
  limit     Float
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, category])
  @@index([userId])
  @@map("budgets")
}

model PaymentTransaction {
  id              String   @id @default(uuid())
  userId          String?
  userEmail       String?
  sessionId       String   @unique
  amount          Float
  currency        String   @default("brl")
  plan            String
  paymentStatus   String   @default("pending")
  status          String   @default("initiated")
  stripePaymentId String?
  metadata        String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([paymentStatus])
  @@map("payment_transactions")
}

model Category {
  id        String   @id @default(uuid())
  userId    String
  name      String
  icon      String?  @default("folder")
  color     String?  @default("#3b82f6")
  type      String   @default("expense")
  isDefault Boolean  @default(false)
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([userId, name])
  @@map("categories")
}

model Plan {
  id          String   @id @default(uuid())
  name        String   @unique
  displayName String
  price       Float    @default(0)
  yearlyPrice Float?
  description String?
  features    String   @default("{}")
  limits      String   @default("{}")
  isActive    Boolean  @default(true)
  order       Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  subscriptions Subscription[]

  @@map("plans")
}

model Subscription {
  id               String    @id @default(uuid())
  userId           String    @unique
  planId           String
  startDate        DateTime  @default(now())
  endDate          DateTime?
  autoRenew        Boolean   @default(true)
  stripeCustomerId String?
  stripeSubId      String?
  status           String    @default("active")
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  plan Plan @relation(fields: [planId], references: [id])

  @@index([planId])
  @@index([status])
  @@map("subscriptions")
}

model Installment {
  id              String   @id @default(uuid())
  userId          String
  description     String
  totalAmount     Float
  numberOfParcels Int
  dueDay          Int
  startDate       DateTime
  status          String   @default("active")
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  user         User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  alerts       FinancialAlert[]
  transactions Transaction[]

  @@index([userId])
  @@index([userId, startDate])
  @@map("installments")
}

model FinancialAlert {
  id            String    @id @default(uuid())
  userId        String
  installmentId String?
  title         String
  description   String?
  type          String    @default("installment")
  severity      String    @default("info")
  amount        Float?
  daysUntilDue  Int?
  dueDate       DateTime?
  isRead        Boolean   @default(false)
  notifiedAt    DateTime? // when the email/push reminder was last sent — prevents re-notifying every day
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  user        User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  installment Installment? @relation(fields: [installmentId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([userId, isRead])
  @@index([installmentId])
  @@index([dueDate])
  @@map("financial_alerts")
}

// ============================================================================
// RECURRING TRANSACTIONS — template that spawns a real Transaction every
// period (weekly/monthly/yearly), advancing nextRunDate as it fires.
// ============================================================================
model RecurringTransaction {
  id          String    @id @default(uuid())
  userId      String
  title       String
  amount      Float
  type        String // INCOME | EXPENSE
  category    String
  frequency   String // weekly | monthly | yearly
  startDate   DateTime
  nextRunDate DateTime
  lastRunDate DateTime?
  active      Boolean   @default(true)
  accountId   String?
  cardId      String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([nextRunDate, active])
  @@map("recurring_transactions")
}

// ============================================================================
// WEB PUSH — self-hosted (VAPID keypair), no third-party account required.
// ============================================================================
model PushSubscription {
  id        String   @id @default(uuid())
  userId    String
  endpoint  String   @unique
  p256dh    String
  auth      String
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("push_subscriptions")
}

// ============================================================================
// OUTBOUND WEBHOOKS — user-configured endpoints notified on domain events,
// signed with an HMAC-SHA256 secret (X-Finix-Signature header).
// ============================================================================
model WebhookSubscription {
  id        String   @id @default(uuid())
  userId    String
  url       String
  secret    String
  events    String // JSON array, e.g. ["transaction.created","goal.completed"]
  active    Boolean  @default(true)
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("webhook_subscriptions")
}

// ============================================================================
// API KEYS — read-only programmatic access (Zapier, spreadsheets, scripts).
// Only the bcrypt hash is stored; the raw key is shown once at creation time.
// ============================================================================
model ApiKey {
  id             String    @id @default(uuid())
  userId         String
  label          String
  keyPrefix      String // first 8 chars of the raw key, shown in the UI to identify it
  keyHash        String // bcrypt hash, verified on every request
  keyFingerprint String    @unique // sha256 of the raw key — O(1) lookup, same pattern as RefreshToken
  lastUsedAt     DateTime?
  createdAt      DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("api_keys")
}

// ============================================================================
// OPEN FINANCE — connected bank accounts via an aggregator (Pluggy by
// default). Requires PLUGGY_CLIENT_ID/PLUGGY_CLIENT_SECRET to actually work;
// the schema and routes exist independently of that configuration.
// ============================================================================
model ExternalConnection {
  id           String    @id @default(uuid())
  userId       String
  provider     String    @default("pluggy")
  itemId       String    @unique
  status       String    @default("pending") // pending | connected | error | disconnected
  institution  String?
  lastSyncedAt DateTime?
  createdAt    DateTime  @default(now())

  user     User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  accounts ExternalAccount[]

  @@index([userId])
  @@map("external_connections")
}

model ExternalAccount {
  id           String   @id @default(uuid())
  connectionId String
  externalId   String
  accountId    String? // linked local Account once mapped by the user
  name         String
  balance      Float    @default(0)
  currency     String   @default("BRL")
  createdAt    DateTime @default(now())

  connection ExternalConnection @relation(fields: [connectionId], references: [id], onDelete: Cascade)

  @@index([connectionId])
  @@map("external_accounts")
}
