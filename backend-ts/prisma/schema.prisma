// Prisma schema — PostgreSQL + Neon
// Documentation: https://pris.ly/d/prisma-schema

generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["omitApi"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id                     String    @id @default(uuid())
  name                   String
  email                  String    @unique
  passwordHash           String
  role                   String    @default("USER")
  blocked                Boolean   @default(false)
  photo                  String?
  googleId               String?   @unique
  authProvider           String?   @default("local")
  plan                   String    @default("FREE")
  stripeCustomerId       String?
  stripeSubscriptionId   String?
  transactionsUsed       Int       @default(0)
  transactionsMonth      String    @default("")
  planExpiresAt          DateTime?
  hasCompletedOnboarding Boolean   @default(false)
  usageType              String?
  companyName            String?
  companyLogo            String?
  businessPurpose        String?
  primaryColor           String?
  phone                  String?
  isVerified             Boolean   @default(false)
  verificationCode       String?
  verificationExpires    DateTime?
  createdAt              DateTime  @default(now())
  updatedAt              DateTime  @updatedAt

  transactions        Transaction[]
  goals               Goal[]
  budgets             Budget[]
  paymentTransactions PaymentTransaction[]
  categories          Category[]
  subscription        Subscription?
  installments        Installment[]
  financialAlerts     FinancialAlert[]
  refreshTokens       RefreshToken[]
  accounts            Account[]
  creditCards         CreditCard[]
  contacts            Contact[]
  splitExpenses       SplitExpense[]

  // 2FA (TOTP)
  twoFactorSecret      String?
  twoFactorEnabled     Boolean @default(false)
  twoFactorBackupCodes String? // JSON array of bcrypt-hashed backup codes

  // Round-up ("arredondamento"): every EXPENSE rounds up to the next whole
  // real, the difference is swept into roundUpGoalId.
  roundUpEnabled Boolean @default(false)
  roundUpGoalId  String?

  // Modo Autônomo/MEI — see services/taxService.ts. Purely a calculator
  // (estimates, not official figures); never files anything with Receita Federal.
  isAutonomous Boolean @default(false)
  taxRegime    String? // "MEI" | "CARNE_LEAO"
  meiActivity  String? // "COMERCIO_INDUSTRIA" | "SERVICOS" | "COMERCIO_SERVICOS" — affects DAS-MEI amount

  recurringTransactions  RecurringTransaction[]
  pushSubscriptions      PushSubscription[]
  webhookSubscriptions   WebhookSubscription[]
  apiKeys                ApiKey[]
  externalConnections    ExternalConnection[]
  goalMemberships        GoalMember[]
  sentGoalInvites        GoalInvite[]                   @relation("GoalInviteSender")
  receivedGoalInvites    GoalInvite[]                   @relation("GoalInviteReceiver")
  debts                  Debt[]
  taxObligations         TaxObligation[]
  challengesCreated      Challenge[]                    @relation("ChallengeCreator")
  challengeEntries       ChallengeParticipant[]
  subscriptionDismissals SubscriptionInsightDismissal[]
  investments            Investment[]
  personalLoans          PersonalLoan[]
  receipts               TransactionReceipt[]
  ownedHousehold         Household?                     @relation("HouseholdOwner")
  householdMemberships   HouseholdMember[]
  sentHouseholdInvites   HouseholdInvite[]               @relation("HouseholdInviteSender")

  @@map("users")
}

model RefreshToken {
  id               String   @id @default(uuid())
  userId           String
  tokenHash        String
  tokenFingerprint String   @unique
  expiresAt        DateTime
  createdAt        DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
  @@map("refresh_tokens")
}

model Transaction {
  id                 String    @id @default(uuid())
  userId             String
  title              String
  amount             Float
  type               String
  category           String
  description        String?
  date               DateTime
  recurring          Boolean   @default(false)
  recurringFrequency String?
  paymentMethod      String?   @default("pix")
  installments       Int       @default(1)
  installmentNumber  Int?
  totalInstallments  Int?
  totalAmount        Float?
  installmentId      String?
  accountId          String?
  cardId             String?
  currency           String    @default("BRL")
  dueDate            DateTime?
  createdAt          DateTime  @default(now())

  // Modo Autônomo: which client/source this income came from — powers the
  // per-client breakdown in the tax estimate.
  client String?

  // Pausa de 24h pra compra por impulso — set client-side when the user
  // answers "não" to "essa compra foi planejada?" on an unusually large
  // expense. The transaction still counts immediately (money already left
  // the account); this only drives the next-day reflection nudge.
  flaggedImpulse Boolean   @default(false)
  reflectedAt    DateTime?

  // Alerta de gasto anômalo — z-score contra a média/desvio da própria
  // categoria do usuário, calculado na criação (ver anomalyDetectionService).
  flaggedAnomaly Boolean @default(false)

  receipt TransactionReceipt?

  user          User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  installment   Installment?   @relation(fields: [installmentId], references: [id], onDelete: SetNull)
  account       Account?       @relation(fields: [accountId], references: [id], onDelete: SetNull)
  card          CreditCard?    @relation(fields: [cardId], references: [id], onDelete: SetNull)
  splitExpenses SplitExpense[]

  @@index([userId])
  @@index([userId, date])
  @@index([installmentId])
  @@index([accountId])
  @@index([cardId])
  @@map("transactions")
}

model Account {
  id        String   @id @default(uuid())
  userId    String
  name      String
  type      String   @default("corrente")
  color     String?  @default("#2563eb")
  isDefault Boolean  @default(false)
  archived  Boolean  @default(false)
  createdAt DateTime @default(now())

  user         User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  transactions Transaction[]

  @@index([userId])
  @@map("accounts")
}

model CreditCard {
  id         String   @id @default(uuid())
  userId     String
  name       String
  brand      String?
  limit      Float    @default(0)
  closingDay Int      @default(1)
  dueDay     Int      @default(10)
  color      String?  @default("#7c3aed")
  archived   Boolean  @default(false)
  createdAt  DateTime @default(now())

  user         User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  transactions Transaction[]

  @@index([userId])
  @@map("credit_cards")
}

model Contact {
  id        String   @id @default(uuid())
  userId    String
  name      String
  email     String?
  phone     String?
  color     String?  @default("#f59e0b")
  createdAt DateTime @default(now())

  user          User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  splitExpenses SplitExpense[]

  @@index([userId])
  @@map("contacts")
}

model SplitExpense {
  id            String    @id @default(uuid())
  userId        String
  transactionId String
  contactId     String
  amount        Float
  settled       Boolean   @default(false)
  settledAt     DateTime?
  createdAt     DateTime  @default(now())

  user        User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  transaction Transaction @relation(fields: [transactionId], references: [id], onDelete: Cascade)
  contact     Contact     @relation(fields: [contactId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([transactionId])
  @@index([contactId])
  @@map("split_expenses")
}

model Goal {
  id            String   @id @default(uuid())
  userId        String
  title         String
  targetAmount  Float
  currentAmount Float    @default(0)
  deadline      DateTime
  createdAt     DateTime @default(now())

  user    User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  members GoalMember[]
  invites GoalInvite[]

  @@index([userId])
  @@index([userId, deadline])
  @@map("goals")
}

// A goal has exactly one implicit owner (Goal.userId, kept for backward
// compatibility with existing rows/queries) plus zero or more members added
// via an accepted GoalInvite — both owner and members can view/contribute.
model GoalMember {
  id       String   @id @default(uuid())
  goalId   String
  userId   String
  role     String   @default("member") // owner | member
  joinedAt DateTime @default(now())

  goal Goal @relation(fields: [goalId], references: [id], onDelete: Cascade)
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([goalId, userId])
  @@index([userId])
  @@map("goal_members")
}

model GoalInvite {
  id            String    @id @default(uuid())
  goalId        String
  senderId      String
  receiverEmail String
  receiverId    String?
  status        String    @default("pending") // pending | accepted | declined
  createdAt     DateTime  @default(now())
  respondedAt   DateTime?

  goal     Goal  @relation(fields: [goalId], references: [id], onDelete: Cascade)
  sender   User  @relation("GoalInviteSender", fields: [senderId], references: [id], onDelete: Cascade)
  receiver User? @relation("GoalInviteReceiver", fields: [receiverId], references: [id], onDelete: SetNull)

  @@index([receiverEmail])
  @@index([goalId])
  @@map("goal_invites")
}

model Budget {
  id        String   @id @default(uuid())
  userId    String
  category  String
  limit     Float
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, category])
  @@index([userId])
  @@map("budgets")
}

model PaymentTransaction {
  id              String   @id @default(uuid())
  userId          String?
  userEmail       String?
  sessionId       String   @unique
  amount          Float
  currency        String   @default("brl")
  plan            String
  paymentStatus   String   @default("pending")
  status          String   @default("initiated")
  stripePaymentId String?
  metadata        String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([paymentStatus])
  @@map("payment_transactions")
}

model Category {
  id        String   @id @default(uuid())
  userId    String
  name      String
  icon      String?  @default("folder")
  color     String?  @default("#3b82f6")
  type      String   @default("expense")
  isDefault Boolean  @default(false)
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([userId, name])
  @@map("categories")
}

model Plan {
  id          String   @id @default(uuid())
  name        String   @unique
  displayName String
  price       Float    @default(0)
  yearlyPrice Float?
  description String?
  features    String   @default("{}")
  limits      String   @default("{}")
  isActive    Boolean  @default(true)
  order       Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  subscriptions Subscription[]

  @@map("plans")
}

model Subscription {
  id               String    @id @default(uuid())
  userId           String    @unique
  planId           String
  startDate        DateTime  @default(now())
  endDate          DateTime?
  autoRenew        Boolean   @default(true)
  stripeCustomerId String?
  stripeSubId      String?
  status           String    @default("active")
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  plan Plan @relation(fields: [planId], references: [id])

  @@index([planId])
  @@index([status])
  @@map("subscriptions")
}

model Installment {
  id              String   @id @default(uuid())
  userId          String
  description     String
  totalAmount     Float
  numberOfParcels Int
  dueDay          Int
  startDate       DateTime
  status          String   @default("active")
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  user         User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  alerts       FinancialAlert[]
  transactions Transaction[]

  @@index([userId])
  @@index([userId, startDate])
  @@map("installments")
}

model FinancialAlert {
  id            String    @id @default(uuid())
  userId        String
  installmentId String?
  title         String
  description   String?
  type          String    @default("installment")
  severity      String    @default("info")
  amount        Float?
  daysUntilDue  Int?
  dueDate       DateTime?
  isRead        Boolean   @default(false)
  notifiedAt    DateTime? // when the email/push reminder was last sent — prevents re-notifying every day
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  user        User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  installment Installment? @relation(fields: [installmentId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([userId, isRead])
  @@index([installmentId])
  @@index([dueDate])
  @@map("financial_alerts")
}

// ============================================================================
// RECURRING TRANSACTIONS — template that spawns a real Transaction every
// period (weekly/monthly/yearly), advancing nextRunDate as it fires.
// ============================================================================
model RecurringTransaction {
  id          String    @id @default(uuid())
  userId      String
  title       String
  amount      Float
  type        String // INCOME | EXPENSE
  category    String
  frequency   String // weekly | monthly | yearly
  startDate   DateTime
  nextRunDate DateTime
  lastRunDate DateTime?
  active      Boolean   @default(true)
  accountId   String?
  cardId      String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([nextRunDate, active])
  @@map("recurring_transactions")
}

// ============================================================================
// WEB PUSH — self-hosted (VAPID keypair), no third-party account required.
// ============================================================================
model PushSubscription {
  id        String   @id @default(uuid())
  userId    String
  endpoint  String   @unique
  p256dh    String
  auth      String
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("push_subscriptions")
}

// ============================================================================
// OUTBOUND WEBHOOKS — user-configured endpoints notified on domain events,
// signed with an HMAC-SHA256 secret (X-Finix-Signature header).
// ============================================================================
model WebhookSubscription {
  id        String   @id @default(uuid())
  userId    String
  url       String
  secret    String
  events    String // JSON array, e.g. ["transaction.created","goal.completed"]
  active    Boolean  @default(true)
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("webhook_subscriptions")
}

// ============================================================================
// API KEYS — read-only programmatic access (Zapier, spreadsheets, scripts).
// Only the bcrypt hash is stored; the raw key is shown once at creation time.
// ============================================================================
model ApiKey {
  id             String    @id @default(uuid())
  userId         String
  label          String
  keyPrefix      String // first 8 chars of the raw key, shown in the UI to identify it
  keyHash        String // bcrypt hash, verified on every request
  keyFingerprint String    @unique // sha256 of the raw key — O(1) lookup, same pattern as RefreshToken
  lastUsedAt     DateTime?
  createdAt      DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("api_keys")
}

// ============================================================================
// OPEN FINANCE — connected bank accounts via an aggregator (Pluggy by
// default). Requires PLUGGY_CLIENT_ID/PLUGGY_CLIENT_SECRET to actually work;
// the schema and routes exist independently of that configuration.
// ============================================================================
model ExternalConnection {
  id           String    @id @default(uuid())
  userId       String
  provider     String    @default("pluggy")
  itemId       String    @unique
  status       String    @default("pending") // pending | connected | error | disconnected
  institution  String?
  lastSyncedAt DateTime?
  createdAt    DateTime  @default(now())

  user     User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  accounts ExternalAccount[]

  @@index([userId])
  @@map("external_connections")
}

model ExternalAccount {
  id           String   @id @default(uuid())
  connectionId String
  externalId   String
  accountId    String? // linked local Account once mapped by the user
  name         String
  balance      Float    @default(0)
  currency     String   @default("BRL")
  createdAt    DateTime @default(now())

  connection ExternalConnection @relation(fields: [connectionId], references: [id], onDelete: Cascade)

  @@index([connectionId])
  @@map("external_accounts")
}

// ============================================================================
// DÍVIDAS — priorização por avalanche (maior juros primeiro) ou snowball
// (menor saldo primeiro), ver services/debtService.ts.
// ============================================================================
model Debt {
  id              String   @id @default(uuid())
  userId          String
  creditor        String
  totalAmount     Float
  remainingAmount Float
  interestRate    Float    @default(0) // % ao mês
  minPayment      Float    @default(0)
  dueDay          Int?
  negotiationUrl  String? // link externo (Serasa Limpa Nome etc.) — nunca uma integração real
  paidOff         Boolean  @default(false)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("debts")
}

// ============================================================================
// MODO AUTÔNOMO/MEI — estimativas de DAS-MEI e Carnê-Leão por mês.
// ============================================================================
model TaxObligation {
  id              String    @id @default(uuid())
  userId          String
  referenceMonth  String // "2026-08"
  type            String // "DAS_MEI" | "CARNE_LEAO"
  grossIncome     Float     @default(0)
  estimatedAmount Float
  dueDate         DateTime
  paid            Boolean   @default(false)
  paidAt          DateTime?
  createdAt       DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, referenceMonth, type])
  @@index([userId])
  @@map("tax_obligations")
}

// ============================================================================
// DESAFIOS EM GRUPO — cada participante tem sua própria meta interna
// (targetAmount compartilhado, progresso individual), com ranking.
// ============================================================================
model Challenge {
  id           String   @id @default(uuid())
  creatorId    String
  title        String
  targetAmount Float
  startDate    DateTime
  endDate      DateTime
  createdAt    DateTime @default(now())

  creator      User                   @relation("ChallengeCreator", fields: [creatorId], references: [id], onDelete: Cascade)
  participants ChallengeParticipant[]

  @@index([creatorId])
  @@map("challenges")
}

model ChallengeParticipant {
  id             String   @id @default(uuid())
  challengeId    String
  userId         String
  progressAmount Float    @default(0)
  joinedAt       DateTime @default(now())

  challenge Challenge @relation(fields: [challengeId], references: [id], onDelete: Cascade)
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([challengeId, userId])
  @@index([userId])
  @@map("challenge_participants")
}

// ============================================================================
// CAÇA-FANTASMA DE ASSINATURAS — assinaturas detectadas automaticamente que
// o usuário decidiu ignorar (não reaparecem no próximo scan).
// ============================================================================
model SubscriptionInsightDismissal {
  id          String   @id @default(uuid())
  userId      String
  signature   String // normalized title + rounded amount, identifies the pattern
  dismissedAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, signature])
  @@index([userId])
  @@map("subscription_insight_dismissals")
}

// ============================================================================
// INVESTIMENTOS — atualização manual (ou puxado de ExternalAccount via Open
// Finance no futuro). Alimenta o patrimônio líquido junto com Account e Debt.
// ============================================================================
model Investment {
  id             String   @id @default(uuid())
  userId         String
  name           String
  type           String // RENDA_FIXA | ACOES | FUNDOS_IMOBILIARIOS | CRIPTO | TESOURO_DIRETO | OUTRO
  investedAmount Float
  currentValue   Float
  externalAccountId String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("investments")
}

// ============================================================================
// COMPROVANTE DE TRANSAÇÃO — tabela separada de propósito: Transaction é
// consultada em massa (dashboard, previsão, orçamentos) e uma foto em base64
// ali dentro reintroduziria o mesmo problema de performance já corrigido no
// User.photo — aqui só é buscada quando alguém abre o comprovante.
// ============================================================================
model TransactionReceipt {
  id            String   @id @default(uuid())
  transactionId String   @unique
  userId        String
  imageData     String // data URI
  createdAt     DateTime @default(now())

  transaction Transaction @relation(fields: [transactionId], references: [id], onDelete: Cascade)
  user        User        @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("transaction_receipts")
}

// ============================================================================
// EMPRÉSTIMOS ENTRE PESSOAS — diferente de SplitExpense (que divide uma
// despesa pontual): aqui é "emprestei/peguei emprestado", com parcelas e
// lembrete de cobrança.
// ============================================================================
model PersonalLoan {
  id           String    @id @default(uuid())
  userId       String
  contactId    String
  direction    String // LENT (eu emprestei) | BORROWED (peguei emprestado)
  principal    Float
  remaining    Float
  installments Int       @default(1)
  dueDay       Int?
  note         String?
  settled      Boolean   @default(false)
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  contact Contact @relation(fields: [contactId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([contactId])
  @@map("personal_loans")
}

// ============================================================================
// MODO CASAL/FAMÍLIA — visão combinada de renda/gastos entre membros, sem
// misturar contas bancárias de verdade. Cada membro continua dono dos
// próprios dados; o household só agrega os totais na leitura.
// ============================================================================
model Household {
  id        String   @id @default(uuid())
  ownerId   String   @unique
  name      String
  createdAt DateTime @default(now())

  owner   User              @relation("HouseholdOwner", fields: [ownerId], references: [id], onDelete: Cascade)
  members HouseholdMember[]
  invites HouseholdInvite[]

  @@map("households")
}

model HouseholdMember {
  id          String   @id @default(uuid())
  householdId String
  userId      String
  joinedAt    DateTime @default(now())

  household Household @relation(fields: [householdId], references: [id], onDelete: Cascade)
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([householdId, userId])
  @@index([userId])
  @@map("household_members")
}

model HouseholdInvite {
  id            String    @id @default(uuid())
  householdId   String
  senderId      String
  receiverEmail String
  status        String    @default("pending") // pending | accepted | declined
  createdAt     DateTime  @default(now())
  respondedAt   DateTime?

  household Household @relation(fields: [householdId], references: [id], onDelete: Cascade)
  sender    User      @relation("HouseholdInviteSender", fields: [senderId], references: [id], onDelete: Cascade)

  @@index([receiverEmail])
  @@index([householdId])
  @@map("household_invites")
}
