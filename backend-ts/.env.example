# Copie para .env e preencha. Só DATABASE_URL e JWT_SECRET são obrigatórios;
# cada integração abaixo fica simplesmente desligada quando não configurada.

# ── Essencial ───────────────────────────────────────────────────────────────
# PostgreSQL (o projeto usa Neon em produção).
DATABASE_URL="postgresql://usuario:senha@localhost:5432/finix"

# Assina os tokens de acesso. Em produção o servidor se recusa a subir sem um
# valor forte. Gere com: openssl rand -hex 48
JWT_SECRET=""
# Validade do token de acesso. O frontend renova sozinho com o refresh token.
JWT_EXPIRES_IN="15m"

NODE_ENV="development"
PORT="8000"

# ── Frontend / CORS ─────────────────────────────────────────────────────────
# Para onde o Stripe e o login Google redirecionam de volta.
FRONTEND_URL="http://localhost:5173"
# Origens extras autorizadas a chamar a API (separadas por vírgula). A lista é
# exata, sem curingas. FRONTEND_URL, finixapp.com.br e localhost já entram.
CORS_ORIGINS=""
# Número de proxies reversos na frente da API (Render, Nginx...). Necessário
# para o rate limit enxergar o IP real de cada cliente.
TRUST_PROXY="1"

# ── Administrador ───────────────────────────────────────────────────────────
# A conta é criada no primeiro boot. A senha só é gravada a partir de
# ADMIN_PASSWORD; sem ela, em produção nenhum admin é criado.
ADMIN_EMAIL="admin@seudominio.com"
ADMIN_PASSWORD=""

# ── E-mail (Gmail) ──────────────────────────────────────────────────────────
# Código de verificação de cadastro e lembretes de vencimento, enviados por
# uma conta Gmail comum com "senha de app" (Conta Google → Segurança →
# Verificação em duas etapas → Senhas de app). Limite de ~500 e-mails por dia.
# Sem essas variáveis nenhum e-mail é enviado: o código só aparece no log.
GMAIL_USER=""
GMAIL_APP_PASSWORD=""
# Nome que aparece como remetente.
EMAIL_FROM_NAME="Finix"

# ── Login com Google ────────────────────────────────────────────────────────
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
GOOGLE_REDIRECT_URI="http://localhost:8000/google/callback"

# ── Stripe ──────────────────────────────────────────────────────────────────
STRIPE_SECRET_KEY=""
# Do endpoint de webhook apontando para /api/stripe/webhook.
STRIPE_WEBHOOK_SECRET=""

# ── Jobs agendados ──────────────────────────────────────────────────────────
# Segredo do endpoint POST /api/cron/run-jobs, chamado pelo agendador externo
# (.github/workflows/daily-jobs.yml). Gere com: openssl rand -hex 32
CRON_SECRET=""
# Fuso usado para decidir "hoje" e "mês atual".
APP_TIMEZONE="America/Sao_Paulo"

# ── Notificações push (Web Push) ────────────────────────────────────────────
# Gere o par com: npx web-push generate-vapid-keys
VAPID_PUBLIC_KEY=""
VAPID_PRIVATE_KEY=""
VAPID_SUBJECT="mailto:suporte@seudominio.com"

# ── Open Finance (Pluggy) ───────────────────────────────────────────────────
# Sem isso, /api/open-finance/* responde 501.
PLUGGY_CLIENT_ID=""
PLUGGY_CLIENT_SECRET=""

# ── Insights com IA ─────────────────────────────────────────────────────────
# Sem a chave, os insights usam apenas as regras locais.
EMERGENT_LLM_KEY=""
