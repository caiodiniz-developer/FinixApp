// Prisma schema — PostgreSQL + Neon
// Documentation: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id                     String    @id @default(uuid())
  name                   String
  email                  String    @unique
  passwordHash           String
  role                   String    @default("USER")
  blocked                Boolean   @default(false)
  photo                  String?
  googleId               String?   @unique
  authProvider           String?   @default("local")
  plan                   String    @default("FREE")
  stripeCustomerId       String?
  stripeSubscriptionId   String?
  transactionsUsed       Int       @default(0)
  transactionsMonth      String    @default("")
  planExpiresAt          DateTime?
  hasCompletedOnboarding Boolean   @default(false)
  usageType              String?
  companyName            String?
  companyLogo            String?
  businessPurpose        String?
  primaryColor           String?
  phone                  String?
  isVerified             Boolean   @default(false)
  verificationCode       String?
  verificationExpires    DateTime?
  createdAt              DateTime  @default(now())
  updatedAt              DateTime  @updatedAt

  transactions        Transaction[]
  goals               Goal[]
  budgets             Budget[]
  paymentTransactions PaymentTransaction[]
  categories          Category[]
  subscription        Subscription?
  installments        Installment[]
  financialAlerts     FinancialAlert[]
  refreshTokens       RefreshToken[]

  @@map("users")
}

model RefreshToken {
  id               String   @id @default(uuid())
  userId           String
  tokenHash        String
  tokenFingerprint String   @unique
  expiresAt        DateTime
  createdAt        DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
  @@map("refresh_tokens")
}

model Transaction {
  id                 String    @id @default(uuid())
  userId             String
  title              String
  amount             Float
  type               String
  category           String
  description        String?
  date               DateTime
  recurring          Boolean   @default(false)
  recurringFrequency String?
  paymentMethod      String?   @default("pix")
  installments       Int       @default(1)
  installmentNumber  Int?
  totalInstallments  Int?
  totalAmount        Float?
  installmentId      String?
  currency           String    @default("BRL")
  dueDate            DateTime?
  createdAt          DateTime  @default(now())

  user        User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  installment Installment? @relation(fields: [installmentId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([userId, date])
  @@index([installmentId])
  @@map("transactions")
}

model Goal {
  id            String   @id @default(uuid())
  userId        String
  title         String
  targetAmount  Float
  currentAmount Float    @default(0)
  deadline      DateTime
  createdAt     DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([userId, deadline])
  @@map("goals")
}

model Budget {
  id        String   @id @default(uuid())
  userId    String
  category  String
  limit     Float
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, category])
  @@index([userId])
  @@map("budgets")
}

model PaymentTransaction {
  id              String   @id @default(uuid())
  userId          String?
  userEmail       String?
  sessionId       String   @unique
  amount          Float
  currency        String   @default("brl")
  plan            String
  paymentStatus   String   @default("pending")
  status          String   @default("initiated")
  stripePaymentId String?
  metadata        String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([paymentStatus])
  @@map("payment_transactions")
}

model Category {
  id        String   @id @default(uuid())
  userId    String
  name      String
  icon      String?  @default("folder")
  color     String?  @default("#3b82f6")
  type      String   @default("expense")
  isDefault Boolean  @default(false)
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([userId, name])
  @@map("categories")
}

model Plan {
  id          String   @id @default(uuid())
  name        String   @unique
  displayName String
  price       Float    @default(0)
  yearlyPrice Float?
  description String?
  features    String   @default("{}")
  limits      String   @default("{}")
  isActive    Boolean  @default(true)
  order       Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  subscriptions Subscription[]

  @@map("plans")
}

model Subscription {
  id               String    @id @default(uuid())
  userId           String    @unique
  planId           String
  startDate        DateTime  @default(now())
  endDate          DateTime?
  autoRenew        Boolean   @default(true)
  stripeCustomerId String?
  stripeSubId      String?
  status           String    @default("active")
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  plan Plan @relation(fields: [planId], references: [id])

  @@index([planId])
  @@index([status])
  @@map("subscriptions")
}

model Installment {
  id              String   @id @default(uuid())
  userId          String
  description     String
  totalAmount     Float
  numberOfParcels Int
  dueDay          Int
  startDate       DateTime
  status          String   @default("active")
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  user         User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  alerts       FinancialAlert[]
  transactions Transaction[]

  @@index([userId])
  @@index([userId, startDate])
  @@map("installments")
}

model FinancialAlert {
  id            String    @id @default(uuid())
  userId        String
  installmentId String?
  title         String
  description   String?
  type          String    @default("installment")
  severity      String    @default("info")
  amount        Float?
  daysUntilDue  Int?
  dueDate       DateTime?
  isRead        Boolean   @default(false)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  user        User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  installment Installment? @relation(fields: [installmentId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([userId, isRead])
  @@index([installmentId])
  @@index([dueDate])
  @@map("financial_alerts")
}
